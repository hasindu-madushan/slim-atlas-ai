{
  "name": "slimatlas",
  "version": "1.0.0",
  "description": "SlimAtlas MCP Server - Model Context Protocol server for browser automation using Lightpanda",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:run": "bun test",
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "start": "bun run src/index.ts",
    "start:http": "bun run src/index.ts --transport=http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fastq": "^1.20.1",
    "puppeteer": "^23.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "trustedDependencies": ["puppeteer"],
  "keywords": [
    "mcp",
    "lightpanda",
    "browser",
    "automation",
    "model-context-protocol"
  ],
  "license": "MIT"
}
